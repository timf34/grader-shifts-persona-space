# Copy to .env (never commit it). Loaded by scripts/_common.py and the pod runner.
HF_TOKEN=                 # read access to the models; write access to HF_DATASET_REPO
HF_DATASET_REPO=          # e.g. timf34/grader-shifts-persona-space-outputs (results pushed during runs)
OPENROUTER_API_KEY=       # role-adherence judge (openai/gpt-4.1-mini via OpenRouter, the Assistant Axis judge)
OPENAI_API_KEY=           # only if judge.provider is switched to openai
ANTHROPIC_API_KEY=        # Q2 School of Reward Hacks judges (claude-sonnet-5, as Betley et al.)
RUNPOD_API_KEY=           # lets an unattended pod job stop itself (SHUTDOWN=stop|terminate)
